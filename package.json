{
  "name": "node-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A node-based HTML canvas for wiring API calls together, starting with OpenRouter.",
  "scripts": {
    "dev": "node scripts/serve.mjs --open",
    "dev:python": "python3 -m http.server 8080",
    "proxy": "node scripts/proxy.mjs",
    "test": "node tests/smoke.mjs",
    "screenshot": "node tests/screenshot.mjs",
    "test:launcher": "bash tests/launcher.sh",
    "test:sigv4": "node tests/sigv4.test.mjs",
    "test:upload": "node tests/model-upload.test.mjs",
    "test:all": "npm test && npm run test:sigv4 && npm run test:upload && npm run test:launcher"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
